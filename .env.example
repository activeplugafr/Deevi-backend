# ---------------------------------------------------------------------------
# Deevi backend configuration
#
# Only the SUPABASE_* values are required to boot. Every other integration
# degrades to a documented mock, so a fresh clone runs the whole marketplace
# loop without a single third-party account. GET /health shows what is live
# and what is mocked at any moment.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
# Comma-separated. Use explicit origins in production, never "*".
CORS_ORIGINS=*

# --- Supabase (REQUIRED) ---------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Postgres connection string. Needed ONLY by `npm run db:migrate`; the running
# API never uses it. Dashboard -> Project Settings -> Database -> Connection
# string -> URI. Use the pooled (port 6543) URI if your host blocks 5432.
DATABASE_URL=

# --- Google OAuth (optional) ----------------------------------------------
# Absent: a development mock accepts any email address as the OAuth `code`,
# so social sign-in is testable end to end. The mock refuses to load when
# NODE_ENV=production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# --- Email (optional) ------------------------------------------------------
# Absent: messages are logged and recorded in notification_deliveries with
# mocked=true. In-app notifications are unaffected.
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=Deevi <no-reply@deevi.ng>

# --- Push notifications (optional) ----------------------------------------
PUSH_PROVIDER=mock
PUSH_API_KEY=

# --- Maps / geocoding (optional) ------------------------------------------
# Absent: coordinates come from the client (map picker or device GPS) and
# distance is computed in Postgres. No geocoding provider is required.
MAPS_PROVIDER=mock
MAPS_API_KEY=

# --- Payments, for artisan premium subscriptions (optional) ---------------
# Absent: the mock provider is used. It still verifies webhook signatures, so
# the whole subscription lifecycle is exercisable. Deevi does NOT process
# payment for jobs themselves in MVP.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Redis (optional) ------------------------------------------------------
# Absent: an in-process cache is used. Note this makes rate limiting
# per-instance, so set this before running more than one API replica.
REDIS_URL=

# --- Background worker -----------------------------------------------------
# The queue is a Postgres table with SELECT ... FOR UPDATE SKIP LOCKED, so it
# is durable and multi-worker-safe with no broker. Set QUEUE_WORKER_ENABLED
# false on API instances if you run the worker as a separate process.
QUEUE_WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_CONCURRENCY=5

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120

# --- Marketplace tuning ----------------------------------------------------
JOB_DEFAULT_EXPIRY_DAYS=30
JOB_MAX_MEDIA=8
JOB_MAX_OPEN_PER_CUSTOMER=20

# --- Upload limits (bytes) -------------------------------------------------
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_VIDEO_BYTES=26214400
UPLOAD_MAX_DOCUMENT_BYTES=10485760

# --- Observability (optional) ---------------------------------------------
# https://observe.nestjs.com
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
